# Local Claude Code permission grants (per-machine)
.claude/settings.local.json

# Secrets — only .env.example is committed
.env
.env.*
!.env.example

# Runtime data
/data/
*.db
*.db-shm
*.db-wal

# Frontend build output; internal/web embeds a committed web/dist/.gitkeep
# placeholder so `go build`/`go test` work on a fresh clone before
# `npm run build` has ever run. See web/embed.go.
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# Go build output
/kipple
/kipple.exe
/bin/
*.test

# Local-only deployment notes (real LAN IP and hostnames); never commit
/deploy-local/

# Internal session notes, kept outside the public repository
docs/HANDOFF-PHASE3.md
docs/plan.md
