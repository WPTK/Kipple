# Secrets: only .env.example is committed
.env
.env.*
!.env.example
# Signing keys and certificates (releases are signed keyless; none belong in the repository)
*.pem
*.key
*.p12
!**/testdata/**

# Runtime data
/data/
*.db
*.db-shm
*.db-wal

# Frontend build output; internal/web embeds a committed web/dist/.gitkeep
# placeholder so `go build`/`go test` work on a fresh clone before
# `npm run build` has ever run. See web/embed.go.
web/node_modules/
web/dist/*
!web/dist/.gitkeep
web/dist-*/

# Go build output
/kipple
/kipple.exe
/bin/
*.test

# Coverage output (uploaded by CI, never committed)
/coverage.out
web/coverage/

# Test, lint and seed output
/*.out
/*.err
web/playwright-report/
web/test-results/
web/blob-report/
web/.eslintcache
web/.vite/
web/.seed.log
web/.seed.err.log
web/.seed.pid
*.log

# Per-machine tooling files the maintainer scripts and their tests expect to be ignored
.claude/settings.local.json
.claude/settings.local.json.bak*
.claude/worktrees/
/scripts/local/
