# Local Claude Code permission grants (per-machine), their backups, and agent worktrees
.claude/settings.local.json
.claude/settings.local.json.bak*
.claude/worktrees/

# npm run seed's own PID/log files (not the throwaway data dir, which lives outside the repo)
web/.seed.log
web/.seed.err.log
web/.seed.pid

# Secrets — only .env.example is committed
.env
.env.*
!.env.example
# Signing keys and certificates (releases are signed keyless; none belong in the repository)
*.pem
*.key
*.p12

# Runtime data
/data/
*.db
*.db-shm
*.db-wal

# Frontend build output; internal/web embeds a committed web/dist/.gitkeep
# placeholder so `go build`/`go test` work on a fresh clone before
# `npm run build` has ever run. See web/embed.go.
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# Go build output
/kipple
/kipple.exe
/bin/
*.test

# Local-only deployment notes (real LAN IP and hostnames); never commit
/deploy-local/

# Scratch output from audits, fuzz and seed runs
/sme.json
/*.out
/*.err
web/dist-*/

# Coverage output (uploaded by CI, never committed)
/coverage.out
web/coverage/
