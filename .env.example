# Copy to .env and fill in real values. Never commit .env — only this file
# is checked in. See internal/config/config.go for parsing and defaults.

# --- Server ---------------------------------------------------------------

# Address the HTTP server listens on. Default ":7080" (all interfaces).
KIPPLE_ADDR=:7080

# Until the web app is built into the image, "/" serves the placeholder page.
# The one-file status page (login, feed health, refresh, live events) is
# always available at /_status.

# Directory holding the SQLite database and other persistent state.
# Default "/data" (the Dockerfile creates and owns this as the nonroot
# user; the compose file mounts a named volume here).
KIPPLE_DATA=/data

# --- Auth -------------------------------------------------------------

# Single-user web login. Required before Kipple will serve the UI.
KIPPLE_USERNAME=owner
KIPPLE_PASSWORD=change-me

# Optional initial Google Reader API (sync client) password. If unset,
# run `kipple api-password` after first start to generate and print one.
KIPPLE_API_PASSWORD=

# --- Networking ---------------------------------------------------------

# Public URL Kipple is reached at. It is the "+url" part of the fetch
# User-Agent and the base of Reader API iconUrl values (when the
# greader.icon_urls setting is on). OPML exports do not use it.
# Example: https://rss.example.com
KIPPLE_PUBLIC_URL=

# Comma-separated IPs allowed to set CF-Connecting-IP and X-Forwarded-Proto
# (client IP for the login lockout and failure delays, and the Secure cookie
# flag). Set this to the address the reverse proxy / tunnel connects FROM as
# Kipple sees it, e.g. 192.0.2.10 (a placeholder; use your own). Leave empty
# to always use the TCP peer address. If a request carries one of those
# headers from a peer that is not listed, the header is ignored and Kipple
# logs a WARN (at most once an hour) naming the peer, so a missing entry is
# easy to spot: without it every visitor shares the proxy's IP and one
# visitor's failed logins can lock everyone out.
KIPPLE_TRUSTED_PROXY_IPS=

# --- Time -----------------------------------------------------------------

# IANA time zone Kipple runs in (time.Local, so log timestamps and local-time
# grouping follow it). Default "America/New_York". An unknown name stops
# startup. time/tzdata is compiled in, so this resolves without a filesystem
# zoneinfo database.
TZ=America/New_York

# --- Fetch scheduler -----------------------------------------------------

# How often the scheduler checks for feeds due to be polled. Default 30s.
KIPPLE_SCHED_TICK=30s

# Number of concurrent fetch worker goroutines. Default 8.
KIPPLE_FETCH_WORKERS=8

# Max concurrent in-flight fetches per host. Default 2.
KIPPLE_FETCH_PER_HOST=2

# --- Logging ------------------------------------------------------------

# log/slog level: debug, info, warn or error. Default info.
KIPPLE_LOG_LEVEL=info

# Set to 1 to also log Google Reader API form values (truncated; the password
# and tokens are always redacted) at debug level with KIPPLE_LOG_LEVEL=debug.
# Useful for diagnosing a new sync client. Default
# unset/false.
KIPPLE_LOG_GREADER_FORMS=
